# Python bytecode & caches
__pycache__/
*.py[codz]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment secrets
.env
.env.local

# Local scratch output (the real build writes into public/assets/)
artifacts_out/
tmp_jobs/
*.blend
*.blend1

# Node tooling used only for ad-hoc three.js verification
node_modules/
package-lock.json
package.json

# IDE & OS
.DS_Store
.vscode/
.idea/

# Python packaging
*.egg-info/

# ---------------------------------------------------------------------------
# NOTE: public/assets/models/*.glb and public/assets/manifest.json are
# committed on purpose. They are the static gallery that GitHub Pages serves,
# they are small (~9 MB total), and committing them means the site is viewable
# from a plain checkout. CI regenerates both on every push to main.
# ---------------------------------------------------------------------------
