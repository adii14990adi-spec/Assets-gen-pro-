# Procedural 3D Asset Generator Studio — Environment Configuration

# Operating mode: "live" (Mode B: local/remote Blender worker) or "github_actions" (Mode A: workflow dispatch + live fallback)
STUDIO_OPERATING_MODE=live

# Blender Runtime Configuration
# Option 1: Standalone Blender binary path (if installed)
BLENDER_EXECUTABLE=
# Option 2: Isolated Blender 4.2 LTS Python 3.11 runtime (created by scripts/setup_blender_runtime.py)
BLENDER_PYTHON_EXECUTABLE=/home/user/.local/blender-runtime/bin/python
BLENDER_HEADLESS_LIBS=/home/user/.local/blender-runtime/headless-libs
PYMESHLAB_HEADLESS_LIBS=/home/user/.local/pymeshlab-headless-libs

# Job Queue & Resource Limits
STUDIO_MAX_CONCURRENT_JOBS=2
STUDIO_JOB_TIMEOUT_SECONDS=180
STUDIO_MAX_RETRIES=1
STUDIO_MAX_OUTPUT_BYTES=104857600
STUDIO_MAX_UPLOAD_BYTES=52428800

# Persistent Storage & Database
STUDIO_STORAGE_DIR=./storage_data
STUDIO_DATABASE_URL=sqlite:///./storage_data/studio.sqlite3
# Optional external public base URL when hosting GLBs on S3 / R2 / CDN
STUDIO_PUBLIC_STORAGE_BASE_URL=

# Optional API Key for privileged operations (workflow trigger, asset deletion). Leave blank for local dev.
STUDIO_API_KEY=

# Mode A: Optional GitHub Actions Dispatch Integration (server-side ONLY — never expose in frontend!)
GITHUB_REPOSITORY=adii14990adi-spec/Assets-gen-pro-
GITHUB_WORKFLOW_ID=generate-asset.yml
GITHUB_REF=main
GITHUB_DISPATCH_TOKEN=
